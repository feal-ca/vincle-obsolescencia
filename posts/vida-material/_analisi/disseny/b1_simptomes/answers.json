{
 "title": "Avaria real darrere dels símptomes de bateria (MobiFix)",
 "language": "es",
 "problem": {
  "archetype": "compare-two-keys",
  "catalog_functions": ["proportions", "comparisons"],
  "statement": "Quan un mòbil no carrega o no s'encén, quantes vegades és realment la bateria i quantes el port o el carregador?",
  "mode": "explanatory"
 },
 "user": {"profile": "general-public", "modifiers": ["cvd", "print-grayscale"]},
 "tasks": {
  "why": {"goal": "present", "search": "lookup", "query": "compare"},
  "low_level": ["gist", "compare", "retrieve-value"],
  "temporal": [],
  "shneiderman": ["overview"]
 },
 "data": {
  "dataset_type": "table",
  "source_file": "../dades/raw/ora_mobifix.csv",
  "keys": [
   {"role": "category", "type": "categorical", "cardinality": 2, "source_column": "problem (símptoma per paraules clau)"},
   {"role": "category2", "type": "categorical", "cardinality": 3, "source_column": "fault_type (agrupat)"}
  ],
  "values": [
   {"role": "measure", "type": "quantitative", "semantics": "share", "derived": true,
    "derivation": "reparacions per (símptoma, grup d'avaria) / reparacions del símptoma, només textos que no esmenten la bateria", "unit": "% de reparacions"}
  ],
  "items": "tiny",
  "filters": ["MobiFix amb text", "textos sense la paraula 'bateria'", "símptomes no_carrega i no_sencen"],
  "normalization": "share of the symptom's repairs",
  "parse": {"delimiter": ",", "decimal": "."}
 },
 "constraints": ["static-only", "exact-values", "few-categories-only"],
 "library": "matplotlib",
 "host": "script",
 "stage_validation": {"stage1": "confirmed", "stage2": "confirmed"}
}
